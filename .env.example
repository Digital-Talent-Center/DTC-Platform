# =============================================================================
# .env.example — DTC Platform
# Template environment variables. COPY to .env and fill in real values.
# JANGAN pernah commit .env ke git!
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="DTC Platform"
APP_ENV=local               # local | staging | production
APP_KEY=                    # Generate with: php artisan key:generate
APP_DEBUG=true              # Set to false in production!
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# Docker Port Bindings (Development only)
# ─────────────────────────────────────────────────────────────────────────────
APP_PORT=80                 # Nginx host port
VITE_PORT=5173              # Vite dev server host port
DB_PORT_EXPOSE=5432         # PostgreSQL host port (dev only)
REDIS_PORT_EXPOSE=6379      # Redis host port (dev only)

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug             # debug | info | warning | error | critical

# ─────────────────────────────────────────────────────────────────────────────
# Database — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres            # Docker service name (use 127.0.0.1 if running outside Docker)
DB_PORT=5432
DB_DATABASE=dtc_platform
DB_USERNAME=postgres
DB_PASSWORD=                # ← FILL IN: strong password required

# ─────────────────────────────────────────────────────────────────────────────
# Cache — Redis (recommended) or database
# ─────────────────────────────────────────────────────────────────────────────
CACHE_STORE=redis           # redis | database | file | array
CACHE_PREFIX=dtc_cache

# ─────────────────────────────────────────────────────────────────────────────
# Queue — Redis (recommended) or database
# ─────────────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis      # redis | database | sync

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis            # Docker service name (use 127.0.0.1 if running outside Docker)
REDIS_PASSWORD=             # ← FILL IN: set a strong password, match redis service command
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis        # redis | database | file | cookie
SESSION_LIFETIME=120        # Minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─────────────────────────────────────────────────────────────────────────────
# Filesystem
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local       # local | s3

# ─────────────────────────────────────────────────────────────────────────────
# Broadcasting
# ─────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log    # log | pusher | reverb | redis

# ─────────────────────────────────────────────────────────────────────────────
# Mail
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log             # log | smtp | mailgun | ses | postmark
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@dtcplatform.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 (optional — for file storage)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────────────────
# Vite (Frontend)
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Midtrans Payment Gateway
# Sandbox:    https://dashboard.sandbox.midtrans.com → Settings > Access Keys
# Production: https://dashboard.midtrans.com → Settings > Access Keys
# ─────────────────────────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=        # ← FILL IN: Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=        # ← FILL IN: Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false  # Set to true for live payments

# Client key exposed to browser via Vite (safe to expose, it's public)
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
# Production Snap URL (switch when MIDTRANS_IS_PRODUCTION=true):
# VITE_MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (FCM)
# Option A: Volume mount (RECOMMENDED)
#   - Download service account JSON from Firebase Console
#   - Copy to Docker volume (see walkthrough.md)
#   - Set path below (relative to /var/www/html inside container)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=storage/app/firebase/firebase-service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# Image tag for production builds
# ─────────────────────────────────────────────────────────────────────────────
IMAGE_TAG=latest
