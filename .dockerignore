# =============================================================================
# .dockerignore — DTC Platform
# Files/dirs excluded from Docker build context
# Keep this list tight: smaller context = faster builds
# =============================================================================

# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Editor/IDE files ─────────────────────────────────────────────────────────
.vscode
.idea
.nova
.fleet
.zed
.editorconfig
*.code-workspace

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Environment files (NEVER bake secrets into image) ────────────────────────
.env
.env.*
!.env.example

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── PHP / Composer ────────────────────────────────────────────────────────────
vendor/
# NOTE: vendor IS copied from the composer-deps stage, not from host

# ── Built frontend assets (built by node-build stage) ────────────────────────
public/build/
public/hot

# ── Laravel runtime / cache (generated at container startup) ─────────────────
bootstrap/cache/*.php
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
storage/app/public/

# ── Firebase credentials (mounted via volume, never baked in) ────────────────
storage/app/firebase/

# ── Test / CI files ──────────────────────────────────────────────────────────
tests/
phpunit.xml
.phpunit.cache/
.phpunit.result.cache
pestphp.xml

# ── Docker compose files (not needed inside image, but docker/ IS needed for build) ──
docker-compose*.yml
# NOTE: Do NOT exclude docker/ — the Dockerfile COPYs config files from docker/php/ and docker/nginx/

# ── Documentation ────────────────────────────────────────────────────────────
README.md
*.md

# ── Misc dev tools ───────────────────────────────────────────────────────────
.prettierrc
.prettierignore
eslint.config.js
tsconfig.json
components.json
Homestead.*
auth.json
